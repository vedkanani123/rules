{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fundedtradingrules.com"
        }
      ],
      "destination": "https://www.fundedtradingrules.com/:path*",
      "permanent": true
    },
    {
      "source": "/prop-firms/crypto-funded-trader",
      "destination": "/prop-firms/crypto-fund-trader",
      "permanent": true
    },
    {
      "source": "/prop-firms/fundednext",
      "destination": "/prop-firms/funded-next",
      "permanent": true
    },
    {
      "source": "/prop-firms/aquafunded",
      "destination": "/prop-firms/aqua-funded",
      "permanent": true
    },
    {
      "source": "/prop-firms/brightfunded",
      "destination": "/prop-firms/bright-funded",
      "permanent": true
    },
    {
      "source": "/prop-firms/fundedelite",
      "destination": "/prop-firms/funded-elite",
      "permanent": true
    },
    {
      "source": "/prop-firms/alpha-capital-group",
      "destination": "/prop-firms/alpha-capital",
      "permanent": true
    },
    {
      "source": "/prop-firms/the5ers",
      "destination": "/prop-firms/the-5ers",
      "permanent": true
    },
    {
      "source": "/prop-firms/the-5-ers",
      "destination": "/prop-firms/the-5ers",
      "permanent": true
    },
    {
      "source": "/prop-firms/fundingpips",
      "destination": "/prop-firms/funding-pips",
      "permanent": true
    },
    {
      "source": "/compare/ftmo-vs-fundednext",
      "destination": "/compare/ftmo-vs-funded-next",
      "permanent": true
    },
    {
      "source": "/firms",
      "destination": "/prop-firms",
      "permanent": true
    },
    {
      "source": "/firms/:slug",
      "destination": "/prop-firms/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(png|jpg|jpeg|svg|webp|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(site.webmanifest|llms.txt|llms-full.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=43200"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
