{
  "name": "prop-firm-rules-intelligence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "validate:data": "tsx scripts/validate-data.ts",
    "validate:rules": "tsx scripts/validate-data.ts --rules-only",
    "crawl": "tsx src/core/crawler/crawlerCLI.ts",
    "crawl:dry-run": "tsx src/core/crawler/crawlerCLI.ts --dry-run",
    "extract": "tsx src/core/pipeline/pipelineCLI.ts extract",
    "detect-changes": "tsx src/core/pipeline/pipelineCLI.ts detect-changes",
    "verify": "tsx src/core/pipeline/pipelineCLI.ts verify",
    "audit": "npm run typecheck && npm run validate:data && npm test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
